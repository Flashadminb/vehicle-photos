{
  "name": "vehicle-photos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "wrangler d1 migrations apply DB --local && wrangler dev --local --port 8787",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "npm run test:worker && npm run test:web",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev:demo": "vite build && wrangler d1 migrations apply DB --local --env demo && wrangler dev --env demo --local --port 8787",
    "dev:api:demo": "wrangler d1 migrations apply DB --local --env demo && wrangler dev --env demo --local --port 8787"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "hono": "^4.13.21",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
