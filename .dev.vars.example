# Copy to .dev.vars for local development with real Google Drive (`npm run dev:api`).
# NEVER commit .dev.vars. In production set these with `wrangler secret put NAME`.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENC_KEY=
# One-time token for creating the first Super Admin (POST /api/setup)
SETUP_TOKEN=
# Optional OCR providers
GOOGLE_VISION_API_KEY=
AIFORTHAI_API_KEY=
# Optional; defaults to the request origin
PUBLIC_BASE_URL=http://localhost:5173
