{
  // Cloudflare Worker serving both the API and the static apps (field at /, dashboard at /admin/).
  // IDs are placeholders: scripts/setup-cloudflare.sh fills them in for the target account.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vehicle-photos",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vehicle-photos",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CACHE",
      "bucket_name": "vehicle-photos-cache"
    }
  ],
  "triggers": {
    // Every 15 minutes: Drive rename/move jobs, OCR, cache eviction at the usage threshold, abandoned rounds.
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    // "google" in production. "demo" = explicitly labelled demo mode with an emulated Drive.
    "DRIVE_MODE": "google",
    "DRIVE_ROOT_FOLDER_ID": "1qjKh1HpA14b63xgmaH5tBhVHF74yGjjp",
    "PASSWORD_ITERATIONS": "100000"
  },
  "observability": { "enabled": true },
  "env": {
    // `wrangler dev --env demo` — local demo mode.
    "demo": {
      "vars": {
        "DRIVE_MODE": "demo",
        "DRIVE_ROOT_FOLDER_ID": "demo-root",
        "PASSWORD_ITERATIONS": "20000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vehicle-photos-demo",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "CACHE", "bucket_name": "vehicle-photos-demo" }]
    }
  }
}
